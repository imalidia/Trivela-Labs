# Copy this file to .env and fill it in. .env is git-ignored, so your key stays off GitHub.
# The AMD endpoint address (OpenAI-compatible, ends in /v1):
AMD_API_BASE=
# Your API key:
AMD_API_KEY=
# Model name to use. Leave empty to use the first model the endpoint lists (it is printed in the log).
AMD_CHAT_MODEL=
