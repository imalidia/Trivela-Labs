# Copy to coach/.env (git-ignored) and fill in. This example file is safe to commit: no real values.
AI_API_KEY=your-provider-api-key
# Any OpenAI-compatible /v1 endpoint
AI_BASE_URL=https://developer.amd.com.cn/radeon/api/v1
# Exact model names from the provider's model list
AI_MODEL=Gemma-4-31B-IT
AI_TOPIC_MODEL=Gemma-4-31B-IT
# Answers instead when the main model is down or times out (optional)
AI_FALLBACK_MODEL=DeepSeek-V4-Flash
AI_DAILY_TOKEN_BUDGET=2000000
AI_VISITOR_SALT=any-long-random-string
